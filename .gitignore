node_modules/

# Retrieval sidecars embed the full text of every retrieved chunk, so committing
# one republishes most of the source corpus. This repository is public and the
# corpus is third-party study reports — keep these local unless the documents
# themselves have been cleared for publication. The paired .txt reports carry
# only chunk metadata (filename, pages, chunkId, scores) and are safe to commit.
retrieval_*.jsonl

# Scratch output. main.js and synthesis_benchmark.js write every run here; the ones a
# report actually cites are promoted into experiments/<nn>-<name>/ and committed there.
runs/

# Source corpora. Same reasoning as above: these are third-party documents and this
# repository is public. The benchmarks reference them by docId and by short verbatim
# quotes in evidence.json; the PDFs themselves stay local.
documents/
experiments/03-synthesis/*.pdf

# The v2 builder's scratch file carries the full source window it generated each
# question from — the same "republishes the corpus" exposure as retrieval_*.jsonl.
# questions.v2.json and evidence.v2.json hold only the question, the answer and a
# short quote, and are safe to commit.
experiments/04-unbiased/generated.raw.jsonl
